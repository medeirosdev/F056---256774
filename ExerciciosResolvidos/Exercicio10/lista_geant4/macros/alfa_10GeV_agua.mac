# Exercicio 1c: alfa de 10 GeV, absorvedor G4_WATER
# rodar com o figura.mac no diretorio atual: exampleB4a -m alfa_10GeV_agua.mac
/control/alias material G4_WATER
/control/alias particula alpha
/control/alias arquivo alfa_10GeV_agua.png
/control/alias titulo "alfa 10 GeV - absorvedor G4_WATER"
/control/alias nvis 1
/control/execute figura.mac
