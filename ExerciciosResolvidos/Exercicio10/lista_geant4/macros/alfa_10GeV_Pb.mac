# Exercicio 1b: alfa de 10 GeV, absorvedor G4_Pb
# rodar com o figura.mac no diretorio atual: exampleB4a -m alfa_10GeV_Pb.mac
/control/alias material G4_Pb
/control/alias particula alpha
/control/alias arquivo alfa_10GeV_Pb.png
/control/alias titulo "alfa 10 GeV - absorvedor G4_Pb"
/control/alias nvis 1
/control/execute figura.mac
