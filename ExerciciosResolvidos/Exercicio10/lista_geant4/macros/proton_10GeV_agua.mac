# Exercicio 1c: proton de 10 GeV, absorvedor G4_WATER
# rodar com o figura.mac no diretorio atual: exampleB4a -m proton_10GeV_agua.mac
/control/alias material G4_WATER
/control/alias particula proton
/control/alias arquivo proton_10GeV_agua.png
/control/alias titulo "proton 10 GeV - absorvedor G4_WATER"
/control/alias nvis 1
/control/execute figura.mac
