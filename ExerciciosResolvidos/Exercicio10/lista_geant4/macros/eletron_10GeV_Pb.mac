# Exercicio 1b: eletron de 10 GeV, absorvedor G4_Pb
# rodar com o figura.mac no diretorio atual: exampleB4a -m eletron_10GeV_Pb.mac
/control/alias material G4_Pb
/control/alias particula e-
/control/alias arquivo eletron_10GeV_Pb.png
/control/alias titulo "eletron 10 GeV - absorvedor G4_Pb"
/control/alias nvis 1
/control/execute figura.mac
