# Macro generica de visualizacao (Exercicio 1b e 1c).
# Usa os aliases definidos pela macro que chama esta:
#   {material}  material do absorvedor (G4_Pb ou G4_WATER)
#   {particula} e-, proton ou alpha
#   {arquivo}   nome do PNG de saida
#   {titulo}    texto do titulo
#   {nvis}      numero de eventos sobrepostos na figura
#
# Uso da visualizacao: TSG_OFFSCREEN grava o PNG direto, sem abrir janela.
# (com o Geant4 compilado com OpenGL/Qt da pra usar o OGL do enunciado:
#  /vis/open OGL 600x600-0+0 ... /vis/ogl/set/exportFormat png ... /vis/ogl/export {arquivo})
/control/verbose 2
/run/verbose 1
/run/numberOfThreads 1
/random/setSeeds 12345 67890

/B4/det/absorberMaterial {material}
/run/initialize

# Particula e energia do feixe
/gun/particle {particula}
/gun/energy 10 GeV

# Visualizacao: acumular as trajetorias de um evento
/vis/open TSG_OFFSCREEN 1400x1000
/vis/tsg/offscreen/set/file {arquivo}
/vis/drawVolume
/vis/viewer/set/style wireframe
/vis/viewer/set/viewpointThetaPhi 70 20
/vis/viewer/zoom 1.2
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/setDefault grey
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/set e- red
/vis/modeling/trajectories/drawByParticleID-0/set e+ blue
/vis/modeling/trajectories/drawByParticleID-0/set proton yellow
/vis/modeling/trajectories/drawByParticleID-0/set alpha magenta
/vis/modeling/trajectories/drawByParticleID-0/set neutron cyan
/vis/modeling/trajectories/drawByParticleID-0/set pi+ 1 0.5 0
/vis/modeling/trajectories/drawByParticleID-0/set pi- 1 0.5 0
/vis/scene/endOfEventAction accumulate

# eixos (x, y, z) com escala e titulo / legenda
/vis/set/textColour white
/vis/scene/add/axes -60 -60 -75 30 mm
/vis/scene/add/scale 50 mm z 1 1 1 manual 0 -70 0 mm
/vis/scene/add/text2D -0.95 0.90 20 ! ! {titulo}
/vis/scene/add/text2D -0.95 0.83 14 ! ! feixe ao longo de +z; calorimetro 10 camadas x (10 mm absorvedor + 5 mm LAr), 10 x 10 x 15 cm
/vis/scene/add/text2D -0.95 -0.80 14 ! ! cores: gama verde | e- vermelho | e+ azul | proton amarelo | alfa magenta | neutron ciano | pions laranja | outros cinza
/vis/scene/add/text2D -0.95 -0.87 14 ! ! eixos x (vermelho), y (verde), z (azul) de 30 mm; barra de escala de 50 mm

/run/beamOn {nvis}
/vis/viewer/flush
