# Exercicio 1c (figura extra): proton de 10 GeV, absorvedor G4_WATER
# rodar com o figura.mac no diretorio atual: exampleB4a -m proton_10GeV_agua_20eventos.mac
/control/alias material G4_WATER
/control/alias particula proton
/control/alias arquivo proton_10GeV_agua_20eventos.png
/control/alias titulo "proton 10 GeV - absorvedor G4_WATER (20 eventos sobrepostos)"
/control/alias nvis 20
/control/execute figura.mac
