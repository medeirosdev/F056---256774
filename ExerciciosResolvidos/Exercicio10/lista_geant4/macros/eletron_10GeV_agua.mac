# Exercicio 1c: eletron de 10 GeV, absorvedor G4_WATER
# rodar com o figura.mac no diretorio atual: exampleB4a -m eletron_10GeV_agua.mac
/control/alias material G4_WATER
/control/alias particula e-
/control/alias arquivo eletron_10GeV_agua.png
/control/alias titulo "eletron 10 GeV - absorvedor G4_WATER"
/control/alias nvis 1
/control/execute figura.mac
