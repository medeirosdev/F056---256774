# Exercicio 2: N eletrons de 10 GeV gravando um registro por passo (ntuple CaloHits)
# Usa os aliases {material} e {neventos}.
/run/numberOfThreads 8
/random/setSeeds 1111 2222
/B4/det/absorberMaterial {material}
/run/initialize
/gun/particle e-
/gun/energy 10 GeV
/run/printProgress 100
/run/beamOn {neventos}
